      ]
    },
    {
      "name": "9. Cleanup (run last)",
      "item": [
        {
          "name": "Delete a sold file (expect 409)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}/files/{{fileId}}/delete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{{productId}}",
                "files",
                "{{fileId}}",
                "delete"
              ]
            },
            "description": "Runs last on purpose, and is expected to be REFUSED. By this point the buyer above has paid for this product and holds a live entitlement, so deleting the file would destroy a purchase someone paid for. The API refuses with 409 file_sold and tells the creator to archive the product instead. Delete the file BEFORE checkout (or revoke the entitlement) and the same request returns 204 - and if it was the last deliverable, the product drops back to draft so the storefront stops offering something checkout would refuse to sell."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('sold file is protected', () => pm.response.to.have.status(409));",
                  "pm.test('says why', () => pm.expect(pm.response.json().error.code).to.eql('file_sold'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
