# ---------- app ----------
APP_ENV=development
LOG_LEVEL=debug
API_PORT=8080
WEB_PORT=3000

# ---------- postgres ----------
POSTGRES_USER=creatorflow
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=creatorflow
POSTGRES_PORT=5432
DATABASE_URL=postgres://creatorflow:devpassword@localhost:5432/creatorflow?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# ---------- redis ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------- object storage (MinIO locally, S3 in prod) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=creatorflow-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---------- auth ----------
# generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-in-every-environment
JWT_REFRESH_SECRET=replace-me-too
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# ---------- payments (test keys only in dev) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- cors ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000
